DJANGO_DEBUG=1
DJANGO_SECRET_KEY=development-only-change-me
POSTGRES_DB=centraliza
POSTGRES_USER=centraliza
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# On Render, DATABASE_URL is injected automatically from the managed database.
# DATABASE_URL=postgresql://user:password@host:5432/centraliza
# Set these after Render and Vercel assign their public domains.
# DJANGO_ALLOWED_HOSTS=centraliza-api.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://centralizavisat.vercel.app
# For an external hosted database, set POSTGRES_SSLMODE=require if required.
# POSTGRES_SSLMODE=require
