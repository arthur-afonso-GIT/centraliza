{
  "manifest_version": 3,
  "name": "Centraliza · Captura SEI demonstrativa",
  "version": "0.2.0",
  "description": "Reconhece páginas fictícias do SEI, avisa sobre a captura e abre uma aba de revisão no Centraliza.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "content_scripts": [{
    "matches": ["http://localhost:3000/mock-sei/*"],
    "js": ["notice.js"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Enviar processo ao Centraliza" }
}
